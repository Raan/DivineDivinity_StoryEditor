<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Version>1.1.0</Version>
    <AssemblyName>StoryEditor</AssemblyName>
    <Product>StoryEditor</Product>
    <Description>Divine Divinity Osiris Story editor and binary decompiler</Description>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\StoryDecompiler.Core\StoryDecompiler.Core.csproj" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <EmbeddedResource Include="..\scripts\BuildStoryWithMerge.ps1" LogicalName="StoryEditor.Scripts.BuildStoryWithMerge.ps1" />
    <EmbeddedResource Include="..\scripts\LoadStoryCheck.ps1" LogicalName="StoryEditor.Scripts.LoadStoryCheck.ps1" />
    <Compile Include="..\StoryEditor.Core\Lexing\*.cs" Link="Lexing\%(Filename)%(Extension)" />
    <Compile Include="..\StoryEditor.Core\Parsing\*.cs" Link="Parsing\%(Filename)%(Extension)" />
    <Compile Include="..\StoryEditor.Core\Documents\*.cs" Link="Documents\%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="RemoveDebugSymbolsFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PublishPdb Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PublishPdb)" />
  </Target>
</Project>
