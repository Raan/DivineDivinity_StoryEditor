<Window x:Class="StoryEditor2.Wpf.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
 Title="StoryEditor — v1.1.0" Width="1500" Height="950"
 MinWidth="1050" MinHeight="650" WindowStartupLocation="CenterScreen"
 Background="#FF1E1E1E" Foreground="#FFE0E0E0">
 <Window.Resources>
  <SolidColorBrush x:Key="PanelBrush" Color="#FF252526"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FF2D2D30"/>
  <SolidColorBrush x:Key="BorderBrushDark" Color="#FF3F3F46"/>
  <SolidColorBrush x:Key="TextBrush" Color="#FFE0E0E0"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#FFAAAAAA"/>
  <SolidColorBrush x:Key="SelectionBrush" Color="#FF264F78"/>
  <!-- A custom scrollbar template avoids the white system-themed track and buttons. -->
  <Style TargetType="{x:Type ScrollBar}">
   <Setter Property="Background" Value="#FF1E1E1E"/>
   <Setter Property="Foreground" Value="#FF686868"/>
   <Setter Property="Width" Value="Auto"/>
   <Setter Property="Height" Value="Auto"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="{x:Type ScrollBar}">
      <Grid Background="#FF1E1E1E" SnapsToDevicePixels="True">
       <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}">
        <Track.DecreaseRepeatButton>
         <RepeatButton Command="ScrollBar.LineUpCommand" Focusable="False"
          IsTabStop="False" Opacity="0" />
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
         <Thumb Background="#FF686868" BorderThickness="0" MinHeight="24" MinWidth="24">
          <Thumb.Template>
           <ControlTemplate TargetType="{x:Type Thumb}">
            <Border x:Name="ThumbBorder" Background="{TemplateBinding Background}"
             CornerRadius="3" Margin="2"/>
            <ControlTemplate.Triggers>
             <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ThumbBorder" Property="Background" Value="#FF858585"/>
             </Trigger>
             <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="ThumbBorder" Property="Background" Value="#FFA0A0A0"/>
             </Trigger>
            </ControlTemplate.Triggers>
           </ControlTemplate>
          </Thumb.Template>
         </Thumb>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
         <RepeatButton Command="ScrollBar.LineDownCommand" Focusable="False"
          IsTabStop="False" Opacity="0"/>
        </Track.IncreaseRepeatButton>
       </Track>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="Orientation" Value="Vertical">
        <Setter Property="Width" Value="13"/>
        <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="True"/>
       </Trigger>
       <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Height" Value="13"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="{x:Type Button}">
   <Setter Property="Background" Value="#FF3E3E42"/>
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="BorderBrush" Value="#FF55555A"/>
   <Setter Property="Padding" Value="9,4"/>
   <Setter Property="Margin" Value="2,0"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="{x:Type Button}">
      <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FF505057"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FF1F1F22"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="{x:Type TextBox}">
   <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="CaretBrush" Value="White"/>
   <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
   <Setter Property="SelectionBrush" Value="{StaticResource SelectionBrush}"/>
   <Setter Property="Padding" Value="5"/>
  </Style>
  <Style TargetType="{x:Type ListBox}">
   <Setter Property="Background" Value="#FF252526"/>
   <Setter Property="Foreground" Value="#FFE0E0E0"/>
   <Setter Property="BorderBrush" Value="#FF3F3F46"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="3"/>
   <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
  </Style>
  <Style TargetType="{x:Type ListBoxItem}">
   <Setter Property="Foreground" Value="#FFE0E0E0"/>
   <Setter Property="Padding" Value="5,4"/>
   <Setter Property="Margin" Value="1"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="{x:Type ListBoxItem}">
      <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}">
       <ContentPresenter/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#FF264F78"/></Trigger>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#FF37373D"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="{x:Type ComboBoxItem}">
   <Setter Property="Foreground" Value="#FFE0E0E0"/>
   <Setter Property="Background" Value="#FF252526"/>
   <Setter Property="Padding" Value="8,5"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
     <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"><ContentPresenter/></Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#FF37373D"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#FF264F78"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#FF777777"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type ComboBox}">
   <Setter Property="Foreground" Value="#FFE0E0E0"/><Setter Property="Background" Value="#FF2D2D30"/>
   <Setter Property="BorderBrush" Value="#FF55555A"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="6,4"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="{x:Type ComboBox}">
     <Grid SnapsToDevicePixels="True">
      <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"/>
      <Grid Margin="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
       <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" RecognizesAccessKey="True"/>
       <ToggleButton Grid.Column="1" Focusable="False" IsTabStop="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" BorderThickness="0">
        <ToggleButton.Template><ControlTemplate TargetType="{x:Type ToggleButton}"><Border Background="Transparent"><Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#FFAAAAAA" Width="8" Height="4" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></ToggleButton.Template>
       </ToggleButton>
       <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
        <Border Background="#FF252526" BorderBrush="#FF55555A" BorderThickness="1" CornerRadius="3" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
         <ScrollViewer CanContentScroll="True" SnapsToDevicePixels="True" Background="#FF252526"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
        </Border>
       </Popup>
      </Grid>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="#FF77777D"/></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="#FF007ACC"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type TreeView}">
   <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
  </Style>
  <Style TargetType="{x:Type TreeViewItem}">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="Padding" Value="2"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="{x:Type TreeViewItem}">
      <StackPanel>
       <Border x:Name="HeaderBorder" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="2">
        <DockPanel>
         <ToggleButton x:Name="Expander" DockPanel.Dock="Left"
          Width="16" Height="18" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
          Focusable="False" IsTabStop="False" Background="Transparent" BorderThickness="0"
          Foreground="#FF9D9D9D" Content="›">
          <ToggleButton.Template>
           <ControlTemplate TargetType="{x:Type ToggleButton}">
            <Border x:Name="ExpanderBorder" Background="Transparent" CornerRadius="2">
             <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
             <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ExpanderBorder" Property="Background" Value="#FF37373D"/>
              <Setter Property="Foreground" Value="#FFE0E0E0"/>
             </Trigger>
             <Trigger Property="IsChecked" Value="True">
              <Setter Property="Content" Value="⌄"/>
             </Trigger>
            </ControlTemplate.Triggers>
           </ControlTemplate>
          </ToggleButton.Template>
         </ToggleButton>
         <ContentPresenter x:Name="HeaderHost" ContentSource="Header" VerticalAlignment="Center"/>
        </DockPanel>
       </Border>
       <ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0"/>
      </StackPanel>
      <ControlTemplate.Triggers>
       <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/></Trigger>
       <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
       <Trigger Property="IsSelected" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="#FF264F78"/></Trigger>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="#FF37373D"/></Trigger>
       <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="White"/></Trigger>
       <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Expander" Property="Content" Value="⌄"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="{x:Type TabControl}">
   <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
   <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
  </Style>
  <Style TargetType="{x:Type TabItem}">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="Background" Value="#FF2D2D30"/>
   <Setter Property="Padding" Value="14,7"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="{x:Type TabItem}">
      <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#FF3F3F46" BorderThickness="1,1,1,0" CornerRadius="3,3,0,0" Padding="{TemplateBinding Padding}">
       <ContentPresenter ContentSource="Header"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FF1E1E1E"/><Setter Property="Foreground" Value="White"/></Trigger>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FF3A3A3D"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="{x:Type GroupBox}">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
  </Style>
  <Style TargetType="{x:Type StatusBar}">
   <Setter Property="Background" Value="#FF007ACC"/>
   <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style TargetType="{x:Type GridSplitter}">
   <Setter Property="Background" Value="#FF3F3F46"/>
  </Style>
 </Window.Resources>
 <DockPanel Background="#FF1E1E1E">
  <!-- Use a regular panel instead of WPF ToolBar: no overflow chevron or white gripper. -->
  <Border DockPanel.Dock="Top" Background="#FF2D2D30" BorderBrush="#FF3F3F46" BorderThickness="0,0,0,1" Padding="5,3">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
     <Button x:Name="DecompileButton" Content="Decompile Story..." Padding="12,4" Click="DecompileStory_Click"/>
     <Button x:Name="OpenButton" Content="Open..." Padding="12,4" Click="Open_Click"/>
     <Button x:Name="SaveButton" Content="Save edited source..." Padding="12,4" Click="Save_Click" IsEnabled="False"/>
     <Button x:Name="BuildButton" Content="Build game story..." Padding="12,4" Click="BuildStory_Click" IsEnabled="False"/>
     <Button x:Name="ConfigureGameButton" Content="Game installation..." Padding="12,4" Click="ConfigureGame_Click"/>
     <Button x:Name="HelpButton" Content="Help" Padding="12,4" Click="Help_Click"/>
     <Border Width="1" Background="#FF55555A" Margin="7,2"/>
    </StackPanel>
    <TextBlock x:Name="DocumentLabel" VerticalAlignment="Center" Text="No document loaded" Foreground="#FFE0E0E0"/>
   </DockPanel>
  </Border>
  <StatusBar DockPanel.Dock="Bottom">
   <TextBlock x:Name="StatusText" Text="Ready"/>
  </StatusBar>
  <Grid Background="#FF1E1E1E">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="350" MinWidth="240"/>
    <ColumnDefinition Width="5"/>
    <ColumnDefinition Width="*" MinWidth="500"/>
   </Grid.ColumnDefinitions>
   <DockPanel Grid.Column="0" Margin="6">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
     <TextBox x:Name="SearchBox" Margin="0,0,0,5" ToolTip="Find Goal by number or title" TextChanged="Search_TextChanged"/>
     <Button x:Name="NewGoalButton" Content="+ New Goal" HorizontalAlignment="Stretch" Click="NewGoal_Click" IsEnabled="False"/>
    </StackPanel>
    <TreeView x:Name="GoalTree" SelectedItemChanged="GoalTree_SelectedItemChanged" ScrollViewer.CanContentScroll="False" VirtualizingStackPanel.IsVirtualizing="False"/>
   </DockPanel>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
   <Grid Grid.Column="2" Margin="6">
    <Grid.RowDefinitions>
     <RowDefinition Height="*"/>
     <RowDefinition Height="180" MinHeight="90"/>
    </Grid.RowDefinitions>
    <TabControl Grid.Row="0" x:Name="SectionTabs">
     <TabItem Header="Goal — Script">
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" MinWidth="170" MaxWidth="360"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="*" MinWidth="250"/>
       </Grid.ColumnDefinitions>
       <DockPanel Grid.Column="0" Background="#FF252526">
        <TextBlock DockPanel.Dock="Top" Text="Rules in this Goal" Foreground="#FFAAAAAA"
         Margin="8,7,4,5" FontSize="12"/>
        <TextBox x:Name="RuleSearchBox" DockPanel.Dock="Top" Margin="6,0,6,6"
         ToolTip="Search rule text, function names, objects, conditions and actions"
         TextChanged="RuleSearch_TextChanged"/>
        <ListBox x:Name="RuleList" SelectionChanged="RuleList_SelectionChanged"
         MouseDoubleClick="RuleList_MouseDoubleClick"
         ToolTip="Double-click a rule to edit it"
         DisplayMemberPath="Label"/>
       </DockPanel>
       <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
       <Grid Grid.Column="2" x:Name="GoalScriptLayoutGrid">
        <Grid.RowDefinitions>
         <RowDefinition Height="*" MinHeight="85"/>
         <RowDefinition Height="5"/>
         <RowDefinition Height="3*" MinHeight="150"/>
         <RowDefinition Height="5"/>
         <RowDefinition Height="*" MinHeight="85"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Background="#FF252526">
         <TextBlock DockPanel.Dock="Top" Text="INIT" Foreground="#FF9CDCFE"
          FontWeight="SemiBold" Padding="7,4"/>
         <avalon:TextEditor x:Name="InitEditor" ShowLineNumbers="True" FontFamily="Consolas"
          FontSize="13" WordWrap="False" Padding="5" IsReadOnly="False"
          Background="#FF1E1E1E" Foreground="#FFD4D4D4" LineNumbersForeground="#FF858585"
          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
          ToolTip="Edit this Goal's INIT actions. Syntax colors match KB."/>
        </DockPanel>
        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
         Background="#FF55555A" ShowsPreview="True"
         ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
         DragCompleted="GoalScriptSplitter_DragCompleted"/>
        <DockPanel Grid.Row="2" Background="#FF252526">
         <TextBlock DockPanel.Dock="Top" Text="KB — RULES" Foreground="#FF9CDCFE"
          FontWeight="SemiBold" Padding="7,4"/>
         <avalon:TextEditor x:Name="KbEditor" ShowLineNumbers="True" FontFamily="Consolas"
          FontSize="13" WordWrap="False" Padding="5" Background="#FF1E1E1E"
          Foreground="#FFD4D4D4" LineNumbersForeground="#FF858585"
          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
          ToolTip="Syntax colors: blue — Osiris keywords; orange — strings/events; green — numbers/API calls; yellow — variables; turquoise — objects; cyan — types/queries; purple — system functions; red — control directives; muted green — comments."/>
        </DockPanel>
        <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch"
         Background="#FF55555A" ShowsPreview="True"
         ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
         DragCompleted="GoalScriptSplitter_DragCompleted"/>
        <DockPanel Grid.Row="4" Background="#FF252526">
         <TextBlock DockPanel.Dock="Top" Text="EXIT" Foreground="#FF9CDCFE"
          FontWeight="SemiBold" Padding="7,4"/>
         <avalon:TextEditor x:Name="ExitEditor" ShowLineNumbers="True" FontFamily="Consolas"
          FontSize="13" WordWrap="False" Padding="5" IsReadOnly="False"
          Background="#FF1E1E1E" Foreground="#FFD4D4D4" LineNumbersForeground="#FF858585"
          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
          ToolTip="Edit this Goal's EXIT actions. Syntax colors match KB."/>
        </DockPanel>
       </Grid>
      </Grid>
     </TabItem>
     <TabItem Header="References">
      <DockPanel Background="#FF252526">
       <TextBlock DockPanel.Dock="Top"
        Text="Search function names, object names or source text across every Goal. Double-click a result to navigate."
        Foreground="#FFAAAAAA" TextWrapping="Wrap" Margin="9,8,9,6"/>
       <TextBox x:Name="CrossReferenceSearchBox" DockPanel.Dock="Top"
        Margin="8,0,8,8" ToolTip="Search all Goals by function, object or text"
        TextChanged="CrossReferenceSearch_TextChanged"/>
       <ListBox x:Name="CrossReferenceList" Margin="4"
        MouseDoubleClick="CrossReferenceList_MouseDoubleClick"
        DisplayMemberPath="Label"
        ToolTip="Double-click a result to open its Goal and select the rule"/>
      </DockPanel>
     </TabItem>
     <TabItem Header="Goal Links">
      <DockPanel Background="#FF252526">
       <TextBlock DockPanel.Dock="Top"
        Text="Explicit Goal-state references from the Osiris API plus clearly marked unverified candidates and shared-call heuristics. Double-click evidence to open its exact KB, INIT or EXIT source location."
        Foreground="#FFAAAAAA" TextWrapping="Wrap" Margin="9,8,9,6"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="260"/><ColumnDefinition Width="5"/><ColumnDefinition Width="2*" MinWidth="300"/></Grid.ColumnDefinitions>
        <ListBox x:Name="GoalLinkList" Grid.Column="0" Margin="4"
         DisplayMemberPath="Label" SelectionChanged="GoalLinkList_SelectionChanged"
         MouseDoubleClick="GoalLinkList_MouseDoubleClick"
         ToolTip="Select a related Goal to inspect direct references and heuristics; double-click to navigate"/>
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
        <Grid Grid.Column="2" Margin="4">
 <Grid.RowDefinitions>
  <RowDefinition Height="2*"/>
  <RowDefinition Height="5"/>
  <RowDefinition Height="*"/>
 </Grid.RowDefinitions>
 <Canvas x:Name="GoalLinkGraphCanvas" Grid.Row="0" Background="#FF202020"
  ClipToBounds="True" SizeChanged="GoalLinkGraphCanvas_SizeChanged"/>
 <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"/>
 <Grid Grid.Row="2">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <TextBox x:Name="GoalLinkDetailsBox" Grid.Row="0" Height="112"
   IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
   VerticalScrollBarVisibility="Auto" Background="#FF202020"
   Foreground="#FFCCCCCC" BorderThickness="0" FontFamily="Consolas" Padding="8"/>
  <ListBox x:Name="GoalLinkEvidenceList" Grid.Row="1" Margin="0,5,0,0"
   DisplayMemberPath="Label" MouseDoubleClick="GoalLinkEvidenceList_MouseDoubleClick"
   ToolTip="Double-click a dependency to open the exact KB, INIT or EXIT source location"/>
 </Grid>
</Grid>
       </Grid>
      </DockPanel>
     </TabItem>

     <TabItem Header="Symbol Explorer">
      <DockPanel Background="#FF252526">
       <TextBlock DockPanel.Dock="Top"
        Text="Browse engine API symbols and Story-defined procedures separately. Select a symbol to inspect its signature, definitions and indexed usages; double-click a Story procedure to open its declaration."
        Foreground="#FFAAAAAA" TextWrapping="Wrap" Margin="9,8,9,6"/>
       <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,8,6">
        <ComboBox x:Name="SymbolKindFilter" Width="155" Margin="0,0,6,0"
         Background="#FF2D2D30" Foreground="#FFE0E0E0"
         SelectionChanged="SymbolFilter_Changed">
         <ComboBoxItem Content="All symbols" IsSelected="True"/>
         <ComboBoxItem Content="Events"/>
         <ComboBoxItem Content="Queries"/>
         <ComboBoxItem Content="Calls"/>
         <ComboBoxItem Content="System queries"/>
         <ComboBoxItem Content="System calls"/>
         <ComboBoxItem Content="Objects"/>
         <ComboBoxItem Content="Types"/>
         <ComboBoxItem Content="Story procedures"/>
         <ComboBoxItem Content="Game database symbols"/>
         <ComboBoxItem Content="Unresolved calls"/>
        </ComboBox>
        <TextBox x:Name="SymbolSearchBox" MinWidth="220" HorizontalAlignment="Stretch"
         ToolTip="Filter symbols by name or signature" TextChanged="SymbolFilter_Changed"/>
       </StackPanel>
       <Grid>
        <Grid.RowDefinitions>
         <RowDefinition Height="150"/>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ListBox x:Name="SymbolList" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
         DisplayMemberPath="Label" SelectionChanged="SymbolList_SelectionChanged"
         MouseDoubleClick="SymbolList_MouseDoubleClick" Margin="4"/>
        <GridSplitter Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
        <TextBox x:Name="SymbolDetailsBox" Grid.Row="0" Grid.Column="2" Margin="4"
         IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
         VerticalScrollBarVisibility="Auto" Background="#FF202020"
         Foreground="#FFCCCCCC" BorderThickness="0" FontFamily="Consolas"/>
        <TextBlock x:Name="SymbolUsageHeader" Grid.Row="1" Grid.Column="2"
         Text="All usages" Foreground="#FFAAAAAA" Margin="7,4,4,2"/>
        <ListBox x:Name="SymbolUsageList" Grid.Row="2" Grid.Column="2" Margin="4"
         DisplayMemberPath="Label" MouseDoubleClick="SymbolUsageList_MouseDoubleClick"
         ToolTip="Double-click a rule to navigate to its Goal and source location"/>
       </Grid>
      </DockPanel>
     </TabItem>
    </TabControl>
    <TabControl Grid.Row="1" Margin="0,6,0,0" SelectedIndex="0">
     <TabItem Header="Grammar">
      <DockPanel Background="#FF252526">
       <TextBlock DockPanel.Dock="Top"
        Text="Live Osiris grammar validation. Double-click a diagnostic to select the corresponding source fragment."
        Foreground="#FFAAAAAA" TextWrapping="Wrap" Margin="9,8,9,6"/>
       <TextBlock x:Name="GrammarSummaryText" DockPanel.Dock="Top"
        Text="Grammar validation is waiting for a document."
        Foreground="#FF9CDCFE" FontWeight="SemiBold" Margin="9,0,9,8"/>
       <ListBox x:Name="GrammarDiagnosticsList" Margin="4"
        DisplayMemberPath="Label" MouseDoubleClick="GrammarDiagnosticsList_MouseDoubleClick"
        ToolTip="Double-click a diagnostic to navigate to and select its source fragment"/>
      </DockPanel>
     </TabItem>
     <TabItem Header="Output">
      <TextBox x:Name="OutputBox" IsReadOnly="True" FontFamily="Consolas"
       FontSize="12" TextWrapping="NoWrap" AcceptsReturn="True"
       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
       Background="#FF202020" Foreground="#FFCCCCCC" CaretBrush="White"
       SelectionBrush="#FF264F78" Padding="5" BorderThickness="0"/>
     </TabItem>
    </TabControl>
   </Grid>
  </Grid>
 </DockPanel>
</Window>